# Copy this file to .env and fill in real values.
# Never commit .env.

# PostgreSQL connection string.
# Example: postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
DATABASE_URL=

# Secret used to sign user and admin JWTs. Use a long random string.
JWT_SECRET=

# Optional. Defaults to HS256.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes. Defaults to 1440 (24 hours).
JWT_EXPIRE_MINUTES=1440

# Comma-separated Vite origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
